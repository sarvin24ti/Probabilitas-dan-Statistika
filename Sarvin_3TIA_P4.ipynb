        "Std Dev",
        f"{std_nilai:.2f}"
    ),

    (
        "Variance",
        f"{variance_nilai:.2f}"
    ),

    (
        "Minimum",
        f"{minimum_nilai:.2f}"
    ),

    (
        "Maximum",
        f"{maximum_nilai:.2f}"
    ),

    (
        "Range",
        f"{range_nilai:.2f}"
    ),

    (
        "Skewness",
        f"{skewness_nilai:.3f}"
    )
]

for i, (nama, hasil) in enumerate(
    ringkasan
):

    posisi_y = (
        0.93 -
        i * 0.09
    )

    ax6.text(

        0.05,

        posisi_y,

        nama,

        transform=ax6.transAxes,

        color=SUBTEXT,

        fontsize=10.5
    )

    ax6.text(

        0.95,

        posisi_y,

        hasil,

        transform=ax6.transAxes,

        ha="right",

        color=ACCENT,

        fontweight="bold",

        fontsize=10.5
    )


