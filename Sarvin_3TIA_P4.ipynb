# %% ========================================================
# A. IMPORT LIBRARY
# =========================================================

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import matplotlib.ticker as mticker


# %% ========================================================
# B. MEMBACA DATA
# =========================================================

path = "sarvin.xlsx"

dataraw = pd.read_excel(path)

kolom_nilai = [
    "KUIS",
    "UTS",
    "UAS",
    "Nilai"
]

for kolom in kolom_nilai:
    if kolom in dataraw.columns:
        dataraw[kolom] = pd.to_numeric(
            dataraw[kolom],
            errors="coerce"
        )


